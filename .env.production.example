# === VibePlan production env ===
# Скопируй в .env.production, заполни секреты, потом `docker compose up -d --build`.

# --- Postgres ---
DATABASE_URL=postgresql://vibeplan:STRONG_PASSWORD@postgres:5432/vibeplan
POSTGRES_PASSWORD=STRONG_PASSWORD

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth (NextAuth v5) ---
# Сгенерируй через: openssl rand -hex 32
AUTH_SECRET=replace-with-32-bytes-of-random-hex
AUTH_URL=https://vibeplan.app

# --- Email magic links ---
RESEND_API_KEY=re_xxxxxxx
EMAIL_FROM=VibePlan <hello@vibeplan.app>

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxx
PRIMARY_MODEL=anthropic/claude-3.5-sonnet
VISION_MODEL=openai/gpt-4o-vision
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Telegram-бот (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# --- Admin (user_id через запятую) ---
# Можно узнать свой id через @userinfobot в Telegram.
ADMIN_USER_IDS=429471588

# --- Public URL (для редиректов NextAuth) ---
NEXTAUTH_URL=https://vibeplan.app