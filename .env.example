# === VibePlan example env ===
# Copy to apps/web/.env.local for Next.js, apps/api/.env for FastAPI, etc.

# Database
DATABASE_URL=postgresql://vibeplan:vibeplan@localhost:5432/vibeplan

# Redis (sessions, cache, BullMQ)
REDIS_URL=redis://localhost:6379

# Auth (NextAuth / Auth.js)
AUTH_SECRET=change-me-to-32-bytes-of-random-data
AUTH_URL=http://localhost:3000

# Email (Resend) — magic links for sign-in
RESEND_API_KEY=
EMAIL_FROM=VibePlan <hello@vibeplan.app>

# AI providers
OPENROUTER_API_KEY=
PRIMARY_MODEL=anthropic/claude-3.5-sonnet
VISION_MODEL=openai/gpt-4o-vision
EMBEDDING_MODEL=openai/text-embedding-3-small

# Speech fallback (optional)
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=

# TTS (optional)
ELEVENLABS_API_KEY=

# Telegram bot (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI service URL (internal)
AI_SERVICE_URL=http://localhost:8001
WEB_INTERNAL_TOKEN=dev-web-secret

# Storage
UPLOAD_DIR=./apps/web/uploads